#!/bin/sh
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
"$ROOT/bin/build"
install -Dm755 "$ROOT/build/omaklok" "$HOME/.local/bin/omaklok"
install -Dm644 "$ROOT/pkgbuild/omaklok.desktop" "$HOME/.local/share/applications/omaklok.desktop"
install -Dm644 "$ROOT/pkgbuild/omaklok.svg" "$HOME/.local/share/icons/hicolor/scalable/apps/omaklok.svg"
if command -v update-desktop-database >/dev/null 2>&1; then update-desktop-database "$HOME/.local/share/applications"; fi
printf '%s\n' 'OmaKlok is geïnstalleerd. Start via de appstarter of ~/.local/bin/omaklok.'
